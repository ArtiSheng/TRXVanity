# deploy.py writes the real file to /dev/shm/trxvanity-secrets.env.
# Recovery only: ./scripts/create-volatile-secrets.sh
# Then start controller.py with:
#   python3 controller.py --env-file /dev/shm/trxvanity-secrets.env run
# Never store the real AES key in this repository or on the server data disk.

TRX_AES_KEY_HEX=REPLACE_WITH_EXACTLY_64_HEXADECIMAL_CHARACTERS
TRX_BACKUP_ENABLED=true

# The controller defaults to the requested HTTPS upload endpoint. Uncomment
# only to point an authorized deployment at a different compatible endpoint.
# TRX_UPLOAD_ENDPOINT=https://example.invalid/upload.php?token=REPLACE_ME

TRX_MONITOR_HOST=127.0.0.1
TRX_MONITOR_PORT=8787
TRX_ENGINE_PROFILE=smart
TRX_UPLOAD_ATTEMPTS=5
TRX_HTTP_TIMEOUT=20

# Formal runs start this script only after upload, download,
# ciphertext hash, HMAC, AES decryption, and every plaintext field are verified.
TRX_CLEANUP_SCRIPT=/root/autodl-fs/TRXVanityLinux/secure_cleanup.sh
